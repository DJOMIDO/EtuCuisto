# Neon : Console > projet > Connect (chaîne de connexion "pooled")
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth : Console > projet > Auth > Configuration
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.eu-central-1.aws.neon.tech/neondb/auth
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Fournisseur d'essai (repli quand l'utilisateur n'a pas ajouté sa propre clé) :
# gemini (gratuit), anthropic, ou mock (données factices, sans réseau).
# Les utilisateurs peuvent configurer leur propre fournisseur/clé dans l'app
# (Profil › Fournisseur de modèle IA) ; leurs requêtes ne comptent alors plus au quota.
AI_PROVIDER=gemini

# https://aistudio.google.com/apikey — sert uniquement de clé d'essai par défaut.
GEMINI_API_KEY=
# Optionnel, défaut : gemini-3.1-flash-lite (repli automatique sur gemini-3.5-flash-lite)
GEMINI_MODEL=

# Seulement si AI_PROVIDER=anthropic — https://platform.claude.com > API keys
ANTHROPIC_API_KEY=
