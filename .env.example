# Neon : Console > projet > Connect (chaîne de connexion "pooled")
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth : Console > projet > Auth > Configuration
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.eu-central-1.aws.neon.tech/neondb/auth
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Fournisseur IA : gemini (gratuit), anthropic, ou mock (données factices, sans réseau)
AI_PROVIDER=gemini

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optionnel, défaut : gemini-3.8-flash
GEMINI_MODEL=

# Seulement si AI_PROVIDER=anthropic — https://platform.claude.com > API keys
ANTHROPIC_API_KEY=
